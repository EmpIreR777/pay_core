# ==============================================================================
# PostgreSQL — параметры для образа postgres (контейнер infra)
# Приложение их НЕ читает, подключение задаётся через DATABASE_URL.
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pay_core

# ==============================================================================
# Application DSN — единый источник правды (12-factor)
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pay_core
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP=localhost:9092

# ==============================================================================
# Service ports
# ==============================================================================
HTTP_PORT=8000
GRPC_PORT=50051

# ==============================================================================
# OpenTelemetry Collector — приложение шлёт телеметрию ТОЛЬКО сюда (:4317/:4318).
# Collector сам делает fan-out в Jaeger (traces) и Prometheus (metrics).
# Приложение НЕ подключается к Jaeger/Prometheus напрямую.
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=payment-gateway

# Лимиты памяти Collector'а (читает memory_limiter в otel_collector/config.yaml).
# limit — жёсткий порог, spike — сколько он может превысить до отброса данных.
OTEL_COLLECTOR_MEMORY_LIMIT_MIB=384
OTEL_COLLECTOR_MEMORY_SPIKE_LIMIT_MIB=96
DEPLOYMENT_ENVIRONMENT=local

# ==============================================================================
# Порты инфраструктуры (docker compose -f infra/docker-compose.yml)
# Приложение на хосте ходит на localhost; контейнеры — на имена сервисов
# (postgres, redis, kafka:29092, otel-collector, prometheus).
# ==============================================================================
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_PROMETHEUS_PORT=8889
OTEL_SELF_METRICS_PORT=8888
OTEL_HEALTH_PORT=13133
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=7d

# Логин Grafana (только для локальной разработки!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin


# ==============================================================================
# Security & Auth
# ==============================================================================
JWT_SECRET=insecure-default-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# Payment Provider ('fake' | 'yookassa')
# ==============================================================================
PAYMENT_PROVIDER=fake
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3
